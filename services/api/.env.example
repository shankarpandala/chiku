# services/api environment — see docs/chiku-architecture.md §13. Never commit real values.
GEMINI_API_KEY=            # AI Studio free tier (dev only — see §9.6)
GCLOUD_TTS_KEY=            # optional, en voices
CHATTERBOX_URL=            # http://<tailscale-ip>:<port> on the M5 Pro
MEDIA_DIR=                 # local media directory
ALLOWED_ORIGIN=http://localhost:5173
PORT=8787                  # local API port (apps/web expects http://localhost:8787)
BRAIN=                     # gemini | rule; default: gemini when a key is set, else rule (dev)
GEMINI_MODEL=              # default gemini-2.5-flash-lite (§7: Flash-Lite, JSON, temp 0)
BRAIN_TIMEOUT_MS=          # default 1200 — the whole §8 miss path budget is 2000
