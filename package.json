{
  "name": "chiku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @chiku/web dev",
    "dev:api": "corepack pnpm --filter @chiku/api dev",
    "dev:prototype": "corepack pnpm --filter @chiku/prototype dev",
    "ingest": "tsx scripts/ingest-design.ts",
    "typecheck": "corepack pnpm -r --filter=!@chiku/prototype run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "corepack pnpm -r --filter=!@chiku/prototype run test && vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
